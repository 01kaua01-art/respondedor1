# ==============================================================================
# Configuração de Chaves de API para os Agentes de IA
# ==============================================================================
# Instruções:
# 1. Copie este arquivo e renomeie a cópia para ".env".
# 2. Preencha apenas as chaves dos provedores que pretende utilizar.
# 3. NUNCA adicione chaves reais neste arquivo (.env.example) e NUNCA versione o .env.
# ==============================================================================

# Google Gemini API (obtenha em: https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# OpenRouter API (obtenha em: https://openrouter.ai/keys)
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Groq Cloud API (obtenha em: https://console.groq.com/keys)
GROQ_API_KEY=sua_chave_groq_aqui
